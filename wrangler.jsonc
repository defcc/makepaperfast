{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "makepaperfast",
  "workers_dev": true,
  "routes": [{ "pattern": "makepaperfast.com", "custom_domain": true }],
  "main": "src/worker.jsx",
  "compatibility_date": "2026-08-01",
  "assets": { "directory": "./dist" },
  "build": { "command": "npm run build:assets", "watch_dir": "src" },
  "define": { "process.env.NODE_ENV": "\"production\"" },
  "minify": true,
  "observability": { "enabled": true }
}
